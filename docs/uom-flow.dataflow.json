  ],
  "nodes": [
    { "id": "part", "type": "database", "label": "Part", "sublabel": "uom_id ke uoms", "stage": 0, "row": 0, "tag": "FK" },
    { "id": "uom", "type": "database", "label": "Uom Master", "sublabel": "KGM / PCS / ROLL / SHEET", "stage": 0, "row": 2, "tag": "typed" },
    { "id": "bomitem", "type": "database", "label": "BOM Item", "sublabel": "uom_rm (string)", "stage": 1, "row": 0, "tag": "teks bebas" },
    { "id": "poitem", "type": "backend", "label": "PO Item", "sublabel": "unit (string)", "stage": 1, "row": 2, "tag": "teks bebas" },
    { "id": "woitem", "type": "database", "label": "WO Item", "sublabel": "uom_rm (string)", "stage": 2, "row": 0, "tag": "snapshot" },
    { "id": "arrivalitem", "type": "backend", "label": "Arrival Item", "sublabel": "unit_goods (string)", "stage": 2, "row": 2, "tag": "teks bebas" },
    { "id": "consumption", "type": "database", "label": "WO Consumption", "sublabel": "uom (string)", "stage": 3, "row": 0, "tag": "ledger" },
    { "id": "receive", "type": "backend", "label": "Receive", "sublabel": "qty_unit (string)", "stage": 3, "row": 2, "tag": "KGM hardcode" },
    { "id": "stock", "type": "database", "label": "Part Stock", "sublabel": "qty_unit (string)", "stage": 4, "row": 1, "tag": "FIFO ledger" }
  ],
  "flows": [
    { "id": "part-uom", "from": "part", "to": "uom", "label": "uom_id", "classification": "referensi master", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "labelAt": [100, 214] },
    { "id": "part-bom", "from": "part", "to": "bomitem", "label": "part_number", "classification": "routing", "variant": "default", "fromSide": "right", "toSide": "left" },
    { "id": "bom-wo", "from": "bomitem", "to": "woitem", "label": "snapshot uom_rm", "classification": "tanpa validasi", "variant": "dashed", "fromSide": "right", "toSide": "left" },
    { "id": "wo-consumption", "from": "woitem", "to": "consumption", "label": "uom", "classification": "konsumsi", "variant": "dashed", "fromSide": "right", "toSide": "left" },
    { "id": "po-arrival", "from": "poitem", "to": "arrivalitem", "label": "unit_goods", "classification": "teks bebas", "variant": "default", "fromSide": "right", "toSide": "left" },
    { "id": "arrival-receive", "from": "arrivalitem", "to": "receive", "label": "qty_unit", "classification": "KGM bila basis berat", "variant": "dashed", "fromSide": "right", "toSide": "left", "labelAt": [637, 340] },
    { "id": "receive-stock", "from": "receive", "to": "stock", "label": "posting qty_unit", "classification": "posting stok", "variant": "emphasis", "fromSide": "right", "toSide": "left", "labelAt": [860, 330] },
    { "id": "consumption-stock", "from": "consumption", "to": "stock", "label": "consume FIFO", "classification": "pengurangan stok", "variant": "default", "fromSide": "right", "toSide": "left", "labelAt": [860, 210] }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Jalur bertipe",
      "items": [
        "Hanya Part.uom_id yang benar-benar FK ke master uoms",
        "Master uoms di-seed: KGM, PCS, ROLL, SHEET",
        "Config PART.default_uom = PCS tidak dipakai di kode mana pun"
      ]
    },
    {
      "dot": "rose",
      "title": "Field string bebas",
      "items": [
        "uom_rm, parent_uom, unit, unit_goods, qty_unit, uom semuanya string",
        "Tidak ada validasi exists:uoms terhadap master",
        "Normalisasi tidak seragam: strtoupper di kode vs LOWER di query FIFO"
      ]
    },
    {
      "dot": "amber",
      "title": "Nilai hardcode",
      "items": [
        "KGM dipaksa saat basis berat di Receive, Stock, API, dan label",
        "Fallback PCS dan unit_bundle PALLET ditulis langsung di kode",
        "Local PO mengizinkan PCS,COIL,SHEET,SET,EA,KGM,ROLL,UOM di luar master"
      ]
    }
  ]
}
